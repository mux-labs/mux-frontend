# Dependencies
node_modules/

# Build output. Tailwind skips git-ignored paths during source detection,
# so these must stay listed for a deterministic CSS build
# (see docs/deterministic-css-build.md).
build/
dist/
.next/
out/
coverage/
storybook-static/
playwright-report/
test-results/

# Environment
.env
.env.local
.env.*.local

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Editor / OS
.DS_Store
.idea/
.vscode/

# Mux local commit message file.
# `.git_msg` is OPTIONAL. It is a local, developer-specific scratch file used to
# draft a commit message before running `git commit`; it is never required by the
# build, CI, or any tooling. If you do not use it, simply ignore this entry.
# Format (when used): plain UTF-8 text, first line = commit subject, blank line,
# then the body. Do not commit it and do not put secrets or tokens in it.
.git_msg

# pnpm content-addressable store (never commit)
.pnpm-store/
