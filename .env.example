# Frontend environment variables — see the "Environment variables" section
# of README.md for full descriptions, defaults, and testnet/mainnet notes.
# Copy this file to .env.local and fill in real values as needed; every
# var here is optional in local development.

# Deployment environment. One of: development | testnet | production.
# Defaults to development when unset. In production, env validation is
# fail-closed: any configuration that would enable mocks (mock flags, mock
# API base URLs, or testnet endpoints) aborts startup instead of silently
# serving mock data. See docs/security-ux-guards.md.
NEXT_PUBLIC_MUX_ENV=

# Base URL for the Mux backend API (no trailing slash).
# Point at a testnet-configured backend for staging, or the production
# backend for mainnet. Falls back to an in-repo mock when unset in
# non-production; in production an unset value is a hard error.
# Example: https://api.muxprotocol.com
NEXT_PUBLIC_API_URL=

# Legacy alias for NEXT_PUBLIC_API_URL, checked second in the fallback chain.
NEXT_PUBLIC_MUX_API_URL=

# Public-facing URL of this application (used for absolute links).
NEXT_PUBLIC_APP_URL=

# WalletConnect project ID, only needed if wallet-connect flows are enabled.
NEXT_PUBLIC_WALLET_CONNECT_PROJECT_ID=

# --- Mock / non-production toggles (rejected in production) ---

# Force the in-repo mock backend instead of a real API. Allowed only in
# development/testnet; setting this to a truthy value in production aborts
# startup (error code ENV_MOCK_IN_PRODUCTION).
NEXT_PUBLIC_USE_MOCKS=

# Base URL for a mock API server. Must not be set in production; a mock
# base URL in production aborts startup (error code ENV_MOCK_IN_PRODUCTION).
NEXT_PUBLIC_MOCK_API_URL=

# --- Server-only vars (never exposed to the browser) ---
#
# INVARIANT (#756): MUX_API_KEY and MUX_API_SECRET are server-only. They must
# never be prefixed with NEXT_PUBLIC_, never referenced from client components
# or shared modules imported by the client, and never passed through
# next.config.ts public env. Access is guarded by a fail-closed runtime check
# (error code ENV_SERVER_SECRET_CLIENT_ACCESS) that throws if the secret is
# read from a client context or if a required server var is missing. See
# docs/security-ux-guards.md and docs/frontend-env-vars.md.

# Mux Protocol API key/secret used by Next.js API routes to authenticate
# upstream requests to the backend. Never prefix these with NEXT_PUBLIC_.
MUX_API_KEY=
MUX_API_SECRET=

# Base URL of mux-backend for /api/spending-limits (spending limits +
# real todayUsage). When unset the route fails closed with a deterministic
# 503 (error code SPENDING_LIMITS_BACKEND_UNCONFIGURED) instead of faking a
# figure; the frontend never persists spending limits itself.
# Required in staging/production — the proxy denies all requests until set.
# Example: https://api.muxprotocol.com
MUX_BACKEND_URL=
